pipeline {
    agent any

    stages {
        stage('Building') {
            steps {
                echo 'Building...'
                sh 'sleep 6'
            }
        }
         stage('Testing') {
            steps {
                echo 'Testing...'
                sh 'sleep 3'
            }
        }
         stage('Deployment to K8S') {
            steps {
                echo 'Deployment Done on Kubernetes Cluster'
                sh 'sleep 3'
            }
        }
        stage('Send email alert') {
                    steps {
                        echo 'Email alert done'
                        sh 'sleep 3'
                    }
                }

  }
  post {
          success {
              echo 'Pipeline succeeded! ✅'
          }
          failure {
              echo 'Pipeline failed! ❌'
          }
      }
}
